TAVILY_API_KEY=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
OLLAMA_BASE_URL=http://localhost:11434

# Non-thinking build -- writes directly to response.content, avoids the
# empty-content bug in the thinking variant (see README).
SUPERVISOR_MODEL=frob/qwen3.5-instruct:9b
WORKER_MODEL=frob/qwen3.5-instruct:9b

# Kept modest for a single 8GB-VRAM GPU running one 9B model at a time.
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=2048

# Bounds total sequential LLM hops for a live demo on single-GPU hardware.
MAX_ITERATIONS=2
MAX_SEARCH_QUERIES=3
TAVILY_MAX_RESULTS=4

# Cross-session memory. Embedding model runs on CPU (see memory.py) so it
# doesn't compete with the 9B generation model for VRAM.
EMBEDDING_MODEL=all-MiniLM-L6-v2
MEMORY_DIR=./.memory
RECALL_TOP_K=3
RECALL_SIMILARITY_THRESHOLD=0.6
